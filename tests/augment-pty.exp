#!/usr/bin/expect -f

set timeout 8
set root [file normalize [file join [file dirname [info script]] ..]]
set binary [file join $root target debug keel-augment]
set fixture [file join $root tests fixtures augment-shell]

spawn env TERM=xterm-256color \
    KEEL_AUGMENT_ROOT=$root \
    KEEL_AUGMENT_BINARY=$binary \
    KEEL_AUGMENT_POC=dashboard \
    KEEL_AUGMENT_PROMPT_MODE=rust \
    KEEL_AUGMENT_CURSOR_MODE=highlight \
    KEEL_AUGMENT_CURSOR_STYLE=bar \
    ZDOTDIR=$fixture \
    zsh -di

expect {
    -re {Keel} {}
    timeout { exit 1 }
}

send -- "printf 'keel-pty-ok\\n'\r"
expect {
    -re {keel-pty-ok} {}
    timeout { exit 1 }
}

send -- "printf 'typing'"
expect {
    -re {typing} {}
    timeout { exit 1 }
}

send -- "\033[D"
send -- "\003"
expect {
    -re {Keel} {}
    timeout { exit 1 }
}

send -- "stty columns 40"
send -- "\r"
sleep 1
send -- "printf 'resized\\n'\r"
expect {
    -re {resized} {}
    timeout { exit 1 }
}

send -- "exit\r"
expect eof
