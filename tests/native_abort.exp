set timeout 30
set repo [lindex $argv 0]
set zsh_bin [lindex $argv 1]

if {$repo eq "" || $zsh_bin eq ""} {
    puts stderr "usage: native_abort.exp REPO_ROOT ZSH_BIN"
    exit 2
}

source [file join $repo tests native_setup.tcl]
log_user 1

send {keel-test al}
expect_popup
send "\003"
expect_native_prompt
send {printf after-abort-ok}
send "\r"
expect {
    -re {after-abort-ok} {}
    timeout {
        puts stderr "Ctrl-C corrupted the first character of the next command"
        exit 1
    }
    eof {
        puts stderr "zsh exited after Ctrl-C"
        exit 1
    }
}
expect_native_prompt

send {keel-test al}
expect_popup
send "\003"
expect_native_prompt
send {printf after-second-abort-ok}
send "\r"
expect {
    -re {after-second-abort-ok} {}
    timeout {
        puts stderr "the second Ctrl-C left the abort guard latched"
        exit 1
    }
    eof {
        puts stderr "zsh exited after the second Ctrl-C"
        exit 1
    }
}
expect_native_prompt

send "\003"
expect_native_prompt
send "exit\r"
expect eof
